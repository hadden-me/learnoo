# Learnoo Compose variables (LRN-010). Copy to deploy/production.env (ignored
# by git) and pass it with --env-file. No secret belongs in this file:
# passwords live in the files under LEARNOO_SECRETS_DIR.
#
# Values marked EXAMPLE are placeholders TO BE DECIDED BY THE INFRASTRUCTURE
# MAINTAINER (docs/DECISIONS.md, "Resource limits, backup retention and
# recovery targets"). They were not measured on the shared server.

# Image built from this repository (docker compose build) or a registry tag.
LEARNOO_IMAGE=learnoo:local

# Database and role names (roles.sql / grants.sql).
LEARNOO_DB_NAME=learnoo
LEARNOO_OWNER_ROLE=learnoo_owner
LEARNOO_RUNTIME_ROLE=learnoo_app

# Host address:port the app is published on; the reverse proxy connects here.
# Keep it on loopback (or a private interface) on the shared server.
LEARNOO_HTTP_PUBLISH=127.0.0.1:8090

# Trusted reverse proxies (issue 46): comma-separated CIDR ranges or addresses
# whose forwarding header is believed. Empty: none. Trust only the address the
# app container sees for the reverse proxy (ideally one /32; with a published
# port that is the Docker gateway of the frontend network, which every host
# process reaching the port shares; see docs/DEPLOYMENT.md). Do NOT list
# Cloudflare's ranges: in X-Forwarded-For mode that trusts every
# Cloudflare-originated client, including other customers' Workers.
# To be decided by the infrastructure maintainer. Ranges broader than /8
# (IPv4) or /16 (IPv6) are refused.
LEARNOO_TRUSTED_PROXIES=
# X-Forwarded-For (default; right-most untrusted hop) or CF-Connecting-IP
# (with Cloudflare in front, and only if the origin proxy accepts connections
# from Cloudflare alone). The choice is an open infrastructure decision.
LEARNOO_CLIENT_ADDRESS_HEADER=X-Forwarded-For

# Public https site root printed in invitation links (no path, no secret).
# EXAMPLE: https://learnoo.example
LEARNOO_PUBLIC_BASE_URL=

# Directory holding pg_superuser_password, db_owner_password and
# db_runtime_password (relative to deploy/).
LEARNOO_SECRETS_DIR=./secrets

# Where the ops backup service writes backups on the host (relative to deploy/).
# EXAMPLE: the location, its encryption and the off-site copy are open.
LEARNOO_BACKUP_HOST_DIR=./backups

# Resource limits. EXAMPLE values only.
LEARNOO_APP_CPUS=1.0
LEARNOO_APP_MEMORY=512m
LEARNOO_APP_PIDS=200
LEARNOO_PG_CPUS=1.0
LEARNOO_PG_MEMORY=1g
LEARNOO_PG_PIDS=200
LEARNOO_PG_SHM_SIZE=128m

# Container log rotation (json-file driver). EXAMPLE values only.
LEARNOO_LOG_MAX_SIZE=10m
LEARNOO_LOG_MAX_FILES=5
