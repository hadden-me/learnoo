# Learnoo reference reverse proxy (issue 87). A reference to adapt, NOT a
# deployed configuration: see docs/DEPLOYMENT.md ("Reference reverse proxy").
# Used by deploy/compose.proxy.yaml; every {$VAR:default} comes from the
# container environment set there.
#
# What it does:
#   - TLS for LEARNOO_PROXY_SITE (default: localhost with Caddy's local CA,
#     "tls internal"); HTTP -> HTTPS redirect (308).
#   - Runs as a non-root user on unprivileged ports inside the container
#     (8080 and 8443; Compose publishes them as the host's 80 and 443).
#   - HSTS on HTTPS responses (max-age configurable, no includeSubDomains,
#     no preload).
#   - Replaces any client-supplied X-Forwarded-For with the single address of
#     the connecting client (no trusted_proxies here, so Caddy trusts no
#     incoming forwarding header); the app trusts only this proxy's /32.
#   - Answers /healthz and /readyz with 404 (container health checks run
#     inside the app container and never pass through here).
#   - Limits request bodies and sets timeouts.
#   - Never overrides the app's headers; removes Server and Via and fills
#     strict defaults on responses the app did not produce, errors included.
#   - Does not cache anything: stock Caddy has no response cache. The app's
#     Cache-Control (no-store / private, no-store; public only for the
#     fingerprinted /assets/<version>/<name> files) is passed through
#     unchanged to browsers and any CDN.
#   - JSON access log on stdout without cookies, credentials, Referer, query
#     strings or invitation tokens (any path naming "invite" in any case or
#     containing a percent-escape is logged as REDACTED).

# Log redaction shared by the access and error logs. The URI is the raw
# request target: /invite/<token> -> /invite/REDACTED; any other path that
# names "invite" (any case, e.g. //invite/, /./Invite/) or contains a
# percent-escape (e.g. /%69nvite/) -> REDACTED; a query string -> ?REDACTED.
(redact_request) {
	request>uri regexp "(?i)^(/invite/)[^?]*|^[^?]*(?:invite|%)[^?]*|(\?).*$" "${1}${2}REDACTED"
	request>headers>Cookie delete
	request>headers>Authorization delete
	request>headers>Proxy-Authorization delete
	request>headers>Referer delete
	request>headers>X-Csrf-Token delete
}

{
	# No admin API: the configuration only changes by restarting the container.
	admin off
	# The local CA (tls internal) is not installed into any trust store.
	skip_install_trust
	# Unprivileged ports inside the container. Caddy's automatic redirect
	# would name port 8443, so the HTTP site below redirects explicitly.
	http_port 8080
	https_port 8443
	auto_https disable_redirects

	# Non-access logs (errors) can include the request; apply the same filter.
	log default {
		output stdout
		format filter {
			wrap json
			import redact_request
		}
	}

	servers {
		# HTTP/1.1 and HTTP/2 only: HTTP/3 would need UDP 443 published too.
		protocols h1 h2
		timeouts {
			read_header {$LEARNOO_PROXY_READ_HEADER_TIMEOUT:10s}
			# Not the binding limit for uploads: the app reads each request
			# (body included) within 15 s and answers a slower upload with
			# 408 upload_timeout. Requests are streamed, not buffered, so a
			# 5 MiB image needs about 3 Mbit/s (see docs/DEPLOYMENT.md).
			read_body {$LEARNOO_PROXY_READ_BODY_TIMEOUT:60s}
			write {$LEARNOO_PROXY_WRITE_TIMEOUT:90s}
			idle {$LEARNOO_PROXY_IDLE_TIMEOUT:2m}
		}
	}
}

# Headers on every response. The app's own headers, including its per-page
# Content-Security-Policy and Cache-Control, are never overridden ("?" only
# fills a missing header): the defaults apply to responses the app did not
# produce (redirects, probe 404s, 413s, proxy errors).
(response_headers) {
	-Server
	-Via
	?Cache-Control "no-store"
	?X-Content-Type-Options "nosniff"
	?X-Frame-Options "DENY"
	?Referrer-Policy "same-origin"
	?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
}

(https_headers) {
	header {
		Strict-Transport-Security "max-age={$LEARNOO_PROXY_HSTS_MAX_AGE:31536000}"
		import response_headers
	}
}

http://{$LEARNOO_PROXY_SITE:localhost} {
	header {
		import response_headers
	}
	# {host} has no port, so this lands on the published 443.
	redir https://{host}{uri} 308
}

https://{$LEARNOO_PROXY_SITE:localhost} {
	# "internal" = Caddy's own local CA (testing). For a real domain set an
	# ACME contact email instead, or an explicit "cert.pem key.pem" pair.
	tls {$LEARNOO_PROXY_TLS:internal}

	log {
		output stdout
		format filter {
			wrap json
			import redact_request
			resp_headers>Set-Cookie delete
			resp_headers>Location delete
		}
	}

	import https_headers

	# Probes are for container health checks and internal monitoring only.
	# The path matcher compares the decoded, case-insensitive path, so
	# /%68ealthz or /HEALTHZ are caught too.
	@probes path /healthz /healthz/* /readyz /readyz/*
	respond @probes 404 {
		close
	}

	# 5 MiB media upload (internal/media MaxUploadBytes) plus headroom; every
	# other body the app accepts is far smaller (lesson JSON 256 KiB).
	# A declared Content-Length above the limit is refused before anything
	# reaches the app; a body without one (chunked, or HTTP/2 without a
	# length) is cut off at the limit while it is read (413, handle_errors).
	@oversized expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {$LEARNOO_PROXY_MAX_BODY_BYTES:6291456}`
	respond @oversized 413 {
		close
	}
	request_body {
		max_size {$LEARNOO_PROXY_MAX_BODY_BYTES:6291456}
	}

	reverse_proxy {$LEARNOO_PROXY_UPSTREAM:app:8090} {
		# Host, Cookie, Origin and Sec-Fetch-Site are passed unchanged.
		# X-Forwarded-For is set to the connecting client's address only.
		transport http {
			dial_timeout 5s
			response_header_timeout {$LEARNOO_PROXY_UPSTREAM_TIMEOUT:60s}
		}
	}

	# Errors raised by Caddy itself (502 upstream down, 413 body too large
	# while streaming, ...): same headers, an empty body.
	handle_errors {
		import https_headers
		respond {err.status_code}
	}
}
