# Keep the build context to sources; never send secrets, backups, build
# outputs or local state. Secret and backup patterns apply at any depth.
.git
.github
.claude
.agents
**/node_modules
**/dist
test-results
playwright-report
internal/rendering/static/vendor
/server
/renderer
**/secrets
**/backups
deploy/production.env
data
media
**/*.dump
**/*.tar
**/*.sql.gz
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
docs
assets
tests
